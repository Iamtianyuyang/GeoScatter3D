{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "GeoScatter3D macOS Studio Design Tokens",
  "version": "2.1.0",
  "color": {
    "system": {
      "blue": { "$value": "#007AFF", "$type": "color", "description": "Primary action button and active navigation accent" },
      "blueHover": { "$value": "#0062CC", "$type": "color" },
      "blueActiveBg": { "$value": "#EBF5FF", "$type": "color", "description": "Active sidebar menu pill background" },
      "green": { "$value": "#10B981", "$type": "color", "description": "Compute ready hardware status indicator" }
    },
    "trafficLights": {
      "close": { "$value": "#FF5F56", "$type": "color" },
      "closeBorder": { "$value": "#E0443E", "$type": "color" },
      "minimize": { "$value": "#FFBD2E", "$type": "color" },
      "minimizeBorder": { "$value": "#DEA123", "$type": "color" },
      "zoom": { "$value": "#27C93F", "$type": "color" },
      "zoomBorder": { "$value": "#1AAB29", "$type": "color" }
    },
    "surface": {
      "sidebar": { "$value": "#F8F9FA", "$type": "color" },
      "sidebarBorder": { "$value": "#E5E7EB", "$type": "color" },
      "main": { "$value": "#FFFFFF", "$type": "color" },
      "card": { "$value": "#FFFFFF", "$type": "color" },
      "cardIllustrationBg": { "$value": "#FAFAFB", "$type": "color" },
      "cardBorder": { "$value": "#E5E7EB", "$type": "color" },
      "cardHoverBorder": { "$value": "#CBD5E1", "$type": "color" },
      "tableBorder": { "$value": "#F3F4F6", "$type": "color" },
      "rowIconBadge": { "$value": "#F3F4F6", "$type": "color" }
    },
    "text": {
      "title": { "$value": "#111827", "$type": "color" },
      "body": { "$value": "#4B5563", "$type": "color" },
      "muted": { "$value": "#9CA3AF", "$type": "color" },
      "activeNav": { "$value": "#007AFF", "$type": "color" }
    }
  },
  "layout": {
    "sidebarWidth": { "$value": "220px", "$type": "dimension" },
    "cardBorderRadius": { "$value": "10px", "$type": "dimension" },
    "buttonBorderRadius": { "$value": "6px", "$type": "dimension" },
    "iconBadgeRadius": { "$value": "6px", "$type": "dimension" }
  },
  "shadow": {
    "card": {
      "$value": "0 2px 6px rgba(0, 0, 0, 0.03)",
      "$type": "shadow"
    },
    "cardHover": {
      "$value": "0 8px 18px rgba(0, 0, 0, 0.06)",
      "$type": "shadow"
    },
    "buttonPrimary": {
      "$value": "0 2px 5px rgba(0, 122, 255, 0.25)",
      "$type": "shadow"
    }
  }
}
