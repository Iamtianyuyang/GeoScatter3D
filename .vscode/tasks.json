{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GeoScatter3D: prepare native runtime",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
        "${workspaceFolder}/scripts/build_flutter_windows.ps1",
        "-Config", "Debug", "-NativeOnly"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "group": "build"
    }
  ]
}
